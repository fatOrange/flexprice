# Deployment environment for the single-host docker-compose.yml stack.
#
#   cp configs/deploy/deploy.env.example .env.deploy
#   chmod 600 .env.deploy
#
# This file contains only what differs per installation:
#   - the released image tag,
#   - the external PostgreSQL connection used by the app and Temporal,
#   - external PostgreSQL passwords and app signing/encryption secrets.
#
# Every other deployment parameter is fixed in docker-compose.yml: service DNS
# names and internal ports, published bind addresses, the bundled ClickHouse
# and Redis passwords, ClickHouse user and database, the app database name and
# TLS mode, Temporal database names and namespace, Kafka topics, deployment
# mode, auth provider and API key map, service identity, log level, and OTEL.
# To change one of those, edit docker-compose.yml (and, for topics,
# configs/deploy/kafka-topics.json). Compose does not read env overrides for
# them from this file.
#
# Generate the secrets with:
#   openssl rand -hex 32        # AUTH_SECRET, SECRETS_ENCRYPTION_KEY
#   openssl rand -base64 24     # external PostgreSQL passwords
#
# Then run:
#   make deploy-config
#   make deploy-init
#   make deploy-up
#
# deploy-init creates schema only. It does not create a tenant or user: after
# the app is healthy, register through POST /v1/auth/signup (see the bootstrap
# section of docs/deployment/swr-compose.md).

# ---------------------------------------------------------------------------
# Released image (SWR, linux/amd64). Pin the sha-<commit>-<run>-<attempt> tag
# for rollbacks instead of latest. This is the only deployment/version knob in
# this file.
# ---------------------------------------------------------------------------
FLEXPRICE_IMAGE=swr.cn-east-3.myhuaweicloud.com/digitprint/flexprice:latest

# ---------------------------------------------------------------------------
# External PostgreSQL used by the Flexprice application.
# The database must already exist. The role needs CREATE on schema public so
# the migration job can build the schema.
#
# Database name and TLS mode are fixed in docker-compose.yml for both the app
# and the migration job: DBNAME=flexprice, SSLMODE=require. The server must
# accept TLS. require encrypts the connection but does not validate the server
# certificate or hostname, so it is not equivalent to verify-full.
# ---------------------------------------------------------------------------
FLEXPRICE_POSTGRES_HOST=postgres.example.internal
FLEXPRICE_POSTGRES_PORT=5432
FLEXPRICE_POSTGRES_USER=flexprice
FLEXPRICE_POSTGRES_PASSWORD=CHANGE_ME_postgres_app_password
# Optional read replica. Leave both unset to route reads to the writer.
# FLEXPRICE_POSTGRES_READER_HOST=postgres-replica.example.internal
# FLEXPRICE_POSTGRES_READER_PORT=5432

# ---------------------------------------------------------------------------
# Temporal persistence on the same external PostgreSQL server.
# Create the databases temporal and temporal_visibility before the first start
# (their names and the default namespace are fixed in docker-compose.yml). The
# role must own them (or have CREATE on schema public in each) because
# auto-setup writes the Temporal and visibility schemas on boot.
# ---------------------------------------------------------------------------
TEMPORAL_POSTGRES_HOST=postgres.example.internal
TEMPORAL_POSTGRES_PORT=5432
TEMPORAL_POSTGRES_USER=flexprice
TEMPORAL_POSTGRES_PASSWORD=CHANGE_ME_temporal_password
# TLS for Temporal's PostgreSQL connections. These values are passed to both
# auto-setup's schema tool and the running Temporal server, whose SQL TLS
# settings come from a separate set of environment variables. This is
# independent of the application connection, which is fixed to
# SSLMODE=require: Temporal can stay on plaintext only if the server permits
# non-TLS connections. Set true if pg_hba.conf uses hostssl for these databases.
TEMPORAL_POSTGRES_TLS_ENABLED=false
# Host directory bind-mounted read-only at /etc/temporal/tls. It must exist.
# The default in docker-compose.yml is ./configs/deploy, which always exists;
# no certificate file is needed while TLS stays disabled.
# TEMPORAL_POSTGRES_TLS_CA_DIR=./configs/deploy
# CA certificate path inside the container; put the file in the directory
# above. Set this for a private CA instead of disabling host verification.
# TEMPORAL_POSTGRES_TLS_CA_FILE=/etc/temporal/tls/ca.pem
# Expected server name (certificate SAN). Optional when the connection host
# already matches the certificate.
# TEMPORAL_POSTGRES_TLS_SERVER_NAME=postgres.example.internal
# Optional client certificate and key for mutual TLS.
# TEMPORAL_POSTGRES_TLS_CERT_FILE=/etc/temporal/tls/client.pem
# TEMPORAL_POSTGRES_TLS_KEY_FILE=/etc/temporal/tls/client-key.pem
# Host verification is on by default. To disable it, set BOTH values below;
# the schema tool takes a disable flag while the server takes an enable flag.
TEMPORAL_POSTGRES_TLS_HOST_VERIFICATION=true
TEMPORAL_POSTGRES_TLS_DISABLE_HOST_VERIFICATION=false

# ---------------------------------------------------------------------------
# Application auth and encryption.
# The auth provider is fixed to flexprice and the API key map to {} in
# docker-compose.yml, which disables the development key baked into the image's
# config.yaml. After signup, create a database-backed key through
# POST /v1/secrets/api/keys; see docs/deployment/swr-compose.md.
# ---------------------------------------------------------------------------
FLEXPRICE_AUTH_SECRET=CHANGE_ME_openssl_rand_hex_32
FLEXPRICE_SECRETS_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32

# ---------------------------------------------------------------------------
# Bundled ClickHouse and Redis credentials are fixed in docker-compose.yml:
#   - ClickHouse: user flexprice, password flexprice_clickhouse
#   - Redis: password flexprice_redis
# These are deployment defaults, not production secrets. Both services publish
# only on 127.0.0.1; never expose their ports publicly or treat these values as
# a security boundary.
#
# On an installation that already has ClickHouse or Redis data in named volumes,
# changing these values in docker-compose.yml does not rotate or rewrite
# credentials already established by the running services or initialized in
# their volumes. Verify the current authentication before switching; do not
# delete the volumes to force a reset.
# ---------------------------------------------------------------------------
